{
  "schema": "ted.mcp-profile.v1",
  "id": "ted-remote-mcp",
  "transport": "streamable-http",
  "runtime": "remote",
  "source": {
    "kind": "external-project-service",
    "repository": "https://github.com/tedming9527/ted-personal-execution-system.git",
    "branch": "main",
    "path": "apps/ted-execution-cloud"
  },
  "environment": {
    "required_names": ["TED_REMOTE_MCP_URL"],
    "optional_names": ["HTTPS_PROXY", "ALL_PROXY", "TED_REMOTE_MCP_CHECK_TIMEOUT_MS"]
  },
  "network": { "mode": "proxy-required", "direct_fallback": false },
  "verification": ["release-metadata", "oauth-protected-resource", "mcp-initialize", "tools-list", "readonly-contract-read", "source-revision-match"],
  "local_overlay_required": true
}
