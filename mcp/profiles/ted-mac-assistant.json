{
  "schema": "ted.mcp-profile.v1",
  "id": "ted-mac-assistant",
  "transport": "stdio",
  "runtime": "python",
  "source": {
    "kind": "external-project-plugin",
    "repository": "https://github.com/tedming9527/ted-personal-execution-system.git",
    "branch": "main",
    "path": "plugins/ted-mac-assistant",
    "marketplace": "ted-execution"
  },
  "environment": { "required_names": ["PLUGIN_ROOT", "PLUGIN_DATA"], "optional_names": [] },
  "network": { "mode": "local-only", "direct_fallback": false },
  "verification": ["mcp-initialize", "tools-list", "readonly-contract-read"],
  "local_overlay_required": true
}
