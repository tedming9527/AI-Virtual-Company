{
  "id": "replace-with-unique-run-id",
  "adapter": "local_process",
  "max_concurrency": 2,
  "poll_ms": 100,
  "timeout_ms": 60000,
  "tasks": [
    {
      "id": "pack-tests",
      "command": "node",
      "args": [
        "--test",
        "mcp/pack-manager/src/core/personal.test.mjs"
      ]
    },
    {
      "id": "runtime-tests",
      "command": "node",
      "args": [
        "--test",
        "scripts/supervisor-runtime.test.mjs"
      ]
    },
    {
      "id": "lifecycle-tests",
      "command": "node",
      "args": [
        "--test",
        "scripts/task-lifecycle.test.mjs"
      ],
      "depends_on": [
        "pack-tests",
        "runtime-tests"
      ]
    }
  ]
}
